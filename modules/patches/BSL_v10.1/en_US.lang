#file "/lang/en_US.lang"

#replace "value.ABOUT.0=by Capt Tatsu"
value.ABOUT.0=by Capt Tatsu

option.PHOTONICS_ENABLED = §e♦ §rUse Photonics
option.PHOTONICS_ENABLED.comment       = Should Photonics be used in this shaderpack?

screen.photonics = §e♦ §rPhotonics Options
screen.photonics_regir = §e♦ §rReGIR Options

option.ALPHA_MODE = §e♦ §rTransparency Mode
option.ALPHA_MODE.comment = Sets how Photonics handles transparent blocks.\n\nNone - Transparent blocks are treated as opaque\nBlock - Transparency is applied per block (§aMinimal performance impact§r)\nVoxel - Transparency is applied per voxel (§cHIGH PERFORMANCE IMPACT§r)
value.ALPHA_MODE.NONE = None
value.ALPHA_MODE.BLOCK = Block
value.ALPHA_MODE.VOXEL = Voxel

option.ENCHANTMENT_GLINT_STRENGTH = §e♦ §rEnchantment Glint Strength
option.ENCHANTMENT_GLINT_STRENGTH.comment = How much enchanted items contribute to handheld lighting
value.ENCHANTMENT_GLINT_STRENGTH.0 = Off

option.SEPARATE_HANDHELD_RAYS = §e♦ §rSeparate Handheld Rays
option.SEPARATE_HANDHELD_RAYS.comment = Whether both handheld lights should cast shadows. When disabled only one shadow will be cast\n\n§aMinimal performance impact
value.SEPARATE_HANDHELD_RAYS.false = §fOff
value.SEPARATE_HANDHELD_RAYS.true = §aOn

option.LIGHTING_MODE = §e♦ §rLighting Mode
option.LIGHTING_MODE.comment = Changes the lighting algorithm Photonics uses.\n\nSimple - Deterministic nearby-light sampling limited by Max Basic Sample Count\nReSTIR - Reservoir resampling across Max Lights, with ReGIR spatial light presampling
value.LIGHTING_MODE.BASIC = Simple
value.LIGHTING_MODE.RESTIR = ReSTIR

option.RESTIR_INITIAL_SAMPLES = ReSTIR Initial Samples
option.RESTIR_INITIAL_SAMPLES.comment = How many lights ReSTIR should initially consider \n\n§eMedium performance impact

option.RESTIR_SOFT_SHADOWS = ReSTIR Soft Shadows
option.RESTIR_SOFT_SHADOWS.comment = Whether ReSTIR should have soft shadows \n\nNo performance impact

option.RESTIR_COMBINED_GI = ReSTIR Combined Gi
option.RESTIR_COMBINED_GI.comment = Whether Gi should be ran through ReSTIR's denoiser instead of its usual path. \nResults in much sharper Gi, at the cost of performance\n\n§cHIGH PERFORMANCE IMPACT
value.RESTIR_COMBINED_GI.false = §fOff
value.RESTIR_COMBINED_GI.true = §aOn

option.RESTIR_SPATIAL_REUSE_SAMPLES = ReSTIR Spatial Reuse Samples
option.RESTIR_SPATIAL_REUSE_SAMPLES.comment = How many samples ReSTIR uses for spatial reuse \n\n§eMedium performance impact

option.RESTIR_SPATIAL_REUSE_RADIUS = ReSTIR Spatial Reuse Radius

option.RESTIR_ACCUMULATION_FRAMES = ReSTIR Accumulation Frames
option.RESTIR_ACCUMULATION_FRAMES.comment = The max number of frames ReSTIR uses for accumulation. Lower values will cause lighting to be more responsive, at the cost of more noise. \n\nNo performance impact

option.RESTIR_DENOISER_PASSES = ReSTIR Denoiser Passes
option.RESTIR_DENOISER_PASSES.comment = The number of passes the denoiser for ReSTIR uses\n\n§eMedium performance impact

value.RESTIR_DENOISER_PASSES.0 = Off

option.REGIR_MODE = ReGIR Spatial Structure
option.REGIR_MODE.comment = Selects the RTXDI ReGIR spatial structure used to presample lights.\n\nGrid - A fixed camera-centered 3D grid\nOnion - Cascaded spherical layers around the camera\nDisabled - Initial light candidates are sampled without ReGIR
value.REGIR_MODE.DISABLED = Disabled
value.REGIR_MODE.GRID = Grid
value.REGIR_MODE.ONION = Onion

option.REGIR_LOCAL_LIGHT_PRESAMPLING_MODE = Local Light Presampling
option.REGIR_LOCAL_LIGHT_PRESAMPLING_MODE.comment = Selects how lights are written into the local presampling table.\n\nUniform - Equal candidate probability\nPower RIS - Importance samples candidates using emitted power
value.REGIR_LOCAL_LIGHT_PRESAMPLING_MODE.UNIFORM = Uniform
value.REGIR_LOCAL_LIGHT_PRESAMPLING_MODE.POWER_RIS = Power RIS

option.REGIR_LOCAL_LIGHT_SAMPLING_FALLBACK_MODE = Local Sampling Fallback
option.REGIR_LOCAL_LIGHT_SAMPLING_FALLBACK_MODE.comment = Selects the proposal used when the jittered surface position falls outside ReGIR coverage.\n\nUniform - Equal light probability\nPower RIS - Importance samples lights using emitted power
value.REGIR_LOCAL_LIGHT_SAMPLING_FALLBACK_MODE.UNIFORM = Uniform
value.REGIR_LOCAL_LIGHT_SAMPLING_FALLBACK_MODE.POWER_RIS = Power RIS

option.REGIR_GRID_SIZE_X = ReGIR Grid Width
option.REGIR_GRID_SIZE_X.comment = Number of cells along the ReGIR grid's X axis. Only used in Grid mode.\n\nThe independent grid and light-count controls are capped so every displayed combination fits OpenGL's portable 128 MiB shader-storage-block limit.

option.REGIR_GRID_SIZE_Y = ReGIR Grid Height
option.REGIR_GRID_SIZE_Y.comment = Number of cells along the ReGIR grid's Y axis. Only used in Grid mode.\n\nThe independent grid and light-count controls are capped so every displayed combination fits OpenGL's portable 128 MiB shader-storage-block limit.

option.REGIR_GRID_SIZE_Z = ReGIR Grid Depth
option.REGIR_GRID_SIZE_Z.comment = Number of cells along the ReGIR grid's Z axis. Only used in Grid mode.\n\nThe independent grid and light-count controls are capped so every displayed combination fits OpenGL's portable 128 MiB shader-storage-block limit.

option.REGIR_ONION_DETAIL_LAYERS = ReGIR Detail Layers
option.REGIR_ONION_DETAIL_LAYERS.comment = Number of high-detail inner layers in the ReGIR onion. Only used in Onion mode.

option.REGIR_ONION_COVERAGE_LAYERS = ReGIR Coverage Layers
option.REGIR_ONION_COVERAGE_LAYERS.comment = Number of lower-detail outer coverage layers in the ReGIR onion. Only used in Onion mode.

option.REGIR_LIGHTS_PER_CELL = ReGIR Lights Per Cell
option.REGIR_LIGHTS_PER_CELL.comment = Number of presampled light slots stored in each ReGIR cell.\n\nThe displayed maximum keeps every grid-size combination within OpenGL's portable 128 MiB shader-storage-block limit. The runtime also clamps this value to the GPU's reported limit without disabling ReGIR.\n\n§cHigh values increase memory use and build cost

option.REGIR_CELL_SIZE = ReGIR Cell Size
option.REGIR_CELL_SIZE.comment = World-space grid cell size. In Onion mode this controls the diameter of the smallest cells.

option.REGIR_SAMPLING_JITTER = ReGIR Sampling Jitter
option.REGIR_SAMPLING_JITTER.comment = Randomizes lookup positions within ReGIR cells to reduce visible cell boundaries. Zero disables jitter.

option.REGIR_BUILD_SAMPLES = ReGIR Build Samples
option.REGIR_BUILD_SAMPLES.comment = Number of light candidates considered when building each ReGIR reservoir.\n\n§eMedium performance impact

option.MAX_LIGHTS = §e♦ §rMax Lights
option.MAX_LIGHTS.comment = The max number of traced lights that can be loaded\n\n§eMedium performance impact

option.MAX_SAMPLES = §e♦ §rMax Basic Sample Count
option.MAX_SAMPLES.comment = The amount of nearby lights that can cast light on an object\n\n§cHIGH PERFORMANCE IMPACT

#endreplace
